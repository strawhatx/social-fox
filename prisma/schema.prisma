generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId        String           @unique @map("clerk_user_id")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  plan               String?
  subscriptionStatus String           @default("inactive") @map("subscription_status")
  subscriptionId     String?          @map("subscription_id")
  subscriptionExpiry DateTime?        @map("subscription_expiry") @db.Timestamptz(6)
  customerId         String?          @unique @map("customer_id")
  contentPosts       ContentPost[]
  conversations      Conversation[]
  library            Library[]
  twitterAccounts    TwitterAccount[]
  userUsage          UserUsage[]

  @@map("users")
}

model TwitterAccount {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  twitterUserId       String    @unique @map("twitter_user_id")
  handle              String
  followersCount      Int       @default(0) @map("followers_count")
  followingCount      Int       @default(0) @map("following_count")
  tweetCount          Int       @default(0) @map("tweet_count")
  listedCount         Int       @default(0) @map("listed_count")
  lastSyncedAt        DateTime? @map("last_synced_at") @db.Timestamptz(6)
  profileImageUrl     String?   @map("profile_image_url")
  backfillStatus      String    @default("pending") @map("backfill_status")
  name                String?
  description         String?
  backfillCompletedAt DateTime? @map("backfill_completed_at")
  backfillStartedAt   DateTime? @map("backfill_started_at")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("twitter_accounts")
}

model ContentPost {
  id          String            @id @default(uuid()) @db.Uuid
  platform    String
  status      String            @default("draft")
  scheduledAt DateTime?         @map("scheduled_at") @db.Timestamptz(6)
  postedAt    DateTime?         @map("posted_at") @db.Timestamptz(6)
  userId      String            @map("user_id") @db.Uuid
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  items       ContentPostItem[]
  analyticsSnapshots AnalyticsSnapshot[]

   @@map("content_posts")
}

model ContentPostItem {
  id        String            @id @default(uuid()) @db.Uuid
  post      ContentPost       @relation(fields: [postId], references: [id])
  postId    String            @map("post_id") @db.Uuid
  parent    ContentPostItem?  @relation("Thread", fields: [parentId], references: [id])
  parentId  String?           @map("parent_id") @db.Uuid
  children  ContentPostItem[] @relation("Thread")
  content   String
  media     Json              @default(dbgenerated("'[]'::jsonb"))
  metadata  Json              @default(dbgenerated("'{}'::jsonb"))
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  analyticsSnapshots AnalyticsSnapshot[]

   @@map("content_post_items")
}

model Library {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  text           String
  category       String
  hashtags       String[] @default([])
  isViralReady   Boolean  @default(false) @map("is_viral_ready")
  characterCount Int?     @map("character_count")
  isStarter      Boolean  @default(false) @map("is_starter")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("library")
}

model Conversation {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  status    String    @default("active")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  role           String
  content        Json         @default("{}")
  createdAt      DateTime     @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  status         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model UserUsage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  feature     String
  used        Int      @default(0)
  periodStart DateTime @map("period_start") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  periodEnd   DateTime @map("period_end") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature, periodStart, periodEnd])
  @@map("user_usage")
}

model AnalyticsSnapshot {
  id             String     @id @default(uuid()) @db.Uuid
  postId         String     @map("post_id") @db.Uuid
  post           ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  itemId         String?    @map("item_id") @db.Uuid
  item           ContentPostItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  snapshotDate   DateTime   @map("snapshot_date") @db.Date
  likes          Int        @default(0)
  retweets       Int        @default(0)
  replies        Int        @default(0)
  impressions    Int?       @default(0)
  engagementRate Float?     @map("engagement_rate")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([postId, itemId, snapshotDate])
  @@map("analytics_snapshots")
}

model BlogPage {
  id              String   @id @default(uuid()) @db.Uuid
  slug            String   @unique
  type            String   // 'blog', 'comparison', 'integration', 'feature'
  title           String
  subtitle        String?
  heroImage       String?  @map("hero_image")
  features        Json?    @default(dbgenerated("'[]'::jsonb")) // For comparison pages
  ctaText         String   @map("cta_text")
  ctaLink         String   @map("cta_link")
  content         String   // Markdown content
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  published       Boolean  @default(false)
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("blog_pages")
}
