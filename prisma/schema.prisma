// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId       String   @unique @map("clerk_user_id")
  plan              String   @default("free")
  subscriptionStatus String  @default("inactive") @map("subscription_status")
  subscriptionId    String?  @map("subscription_id")
  subscriptionExpiry DateTime? @map("subscription_expiry") @db.Timestamptz
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  twitterAccounts   TwitterAccount[]
  contentPosts      ContentPost[]
  userQuota         UserQuota?
  library           Library[]
  aiTemplates       AiTemplate[]

  @@map("users")
}

model TwitterAccount {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  twitterUserId     String   @unique @map("twitter_user_id")
  handle            String
  name              String?
  description       String?
  profileImageUrl   String?  @map("profile_image_url")
  followersCount    Int      @default(0) @map("followers_count")
  followingCount    Int      @default(0) @map("following_count")
  tweetCount        Int      @default(0) @map("tweet_count")
  listedCount       Int      @default(0) @map("listed_count")
  lastSyncedAt      DateTime? @map("last_synced_at") @db.Timestamptz
  backfillStatus    String   @default("pending") @map("backfill_status")
  backfillStartedAt DateTime? @map("backfill_started_at")
  backfillCompletedAt DateTime? @map("backfill_completed_at")

  // Relations
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("twitter_accounts")
}

model ContentPost {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  content           String
  platform          String
  status            String   @default("draft")
  scheduledAt       DateTime? @map("scheduled_at") @db.Timestamptz
  postedAt          DateTime? @map("posted_at") @db.Timestamptz
  engagement        Json     @default("{}")
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("content_posts")
}

model UserQuota {
  id                Int      @id @default(autoincrement())
  userId            String   @unique @map("user_id") @db.Uuid
  postsUsed         Int      @default(0) @map("posts_used")
  postsLimit        Int      @default(0) @map("posts_limit")
  aiPostsUsed       Int      @default(0) @map("ai_posts_used")
  aiPostsLimit      Int      @default(0) @map("ai_posts_limit")
  aiRewritesUsed    Int      @default(0) @map("ai_rewrites_used")
  aiRewritesLimit   Int      @default(0) @map("ai_rewrites_limit")
  resetDate         DateTime @map("reset_date") @db.Timestamptz
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_quotas")
}

model Library {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String?  @map("user_id") @db.Uuid
  text              String
  category          String
  hashtags          String[] @default([])
  isViralReady      Boolean  @default(false) @map("is_viral_ready")
  isStarter         Boolean  @default(false) @map("is_starter")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user              User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("library")
}

model AiTemplate {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  text              String
  createdAt         DateTime @map("created_at") @db.Timestamptz
  insertedAt        DateTime @default(now()) @map("inserted_at") @db.Timestamptz

  // Relations
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_templates")
}

model AiTrainingTweet {
  id                Int      @id @default(autoincrement())
  authorName        String?  @map("author_name")
  authorHandle      String?  @map("author_handle")
  tweetText         String?  @map("tweet_text")
  datePosted        DateTime? @map("date_posted")
  type              String?

  @@map("ai_training_tweets")
}